# --- ClickHouse Cloud (read-only demo user, see sql/00_create_user.sql) ---
CLICKHOUSE_HOST=your-service.eu-west-1.aws.clickhouse.cloud
CLICKHOUSE_USER=mcp_agent
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_SECURE=true

# --- ClickHouse MCP server (run locally over HTTP, see README) ---
CLICKHOUSE_MCP_SERVER_TRANSPORT=http
CLICKHOUSE_MCP_AUTH_TOKEN=generate-with-openssl-rand-hex-32
MCP_URL=http://127.0.0.1:8000/mcp

# --- Langfuse Cloud ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-haiku-4-5-20251001
